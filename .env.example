# ═══════════════════════════════════════════════════════════════════════════
# Zalo Bot Scanner — Biến môi trường (copy thành .env rồi điền giá trị thật)
# Dấu ★ = BẮT BUỘC trên VPS. Còn lại có giá trị mặc định hợp lý.
# KHÔNG commit file .env thật lên git.
# ═══════════════════════════════════════════════════════════════════════════

# ── Zalo Bot ★ ────────────────────────────────────────────────────────────
# Tạo bot tại https://bot.zaloplatforms.com → lấy token dạng <id>:<secret>
ZALO_BOT_TOKEN=

# ── Beeknoee AI (OpenAI-compatible proxy) ★ ──────────────────────────────
# https://platform.beeknoee.com → API keys
BEEKNOEE_API_KEY=
BEEKNOEE_BASE_URL=https://platform-api.beeknoee.com/v1

# Model bóc dữ liệu từ ảnh (vision). Rẻ + OCR tiếng Việt tốt:
VISION_MODEL=gemini-2.5-flash-lite
# Model dự phòng khi JSON lỗi hoặc confidence thấp:
VISION_FALLBACK_MODEL=gemini-2.5-flash
# Model trả lời câu hỏi thống kê (text-only):
NLQ_MODEL=gemini-2.5-flash-lite

# ── Database ★ (Supabase Postgres cho production) ─────────────────────────
#
# Supabase có 2 connection string — LẤY TỪ: Supabase Dashboard → Settings → Database
#
# 1) App runtime → dùng cổng POOLED 6543 (PgBouncer — kết nối nhẹ hơn):
#    Transaction mode, phù hợp với SQLAlchemy pooling của bot.
DATABASE_URL=postgresql+psycopg://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# 2) Alembic migration → dùng cổng DIRECT 5432 (kết nối thẳng DB):
#    PgBouncer (6543) không hỗ trợ DDL statements — Alembic bắt buộc dùng 5432.
DATABASE_MIGRATION_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres
#
# ── Dev local (SQLite, không cần Supabase) ───────────────────────────────
# Bỏ comment 2 dòng dưới và comment 2 dòng Supabase trên để chạy local:
# DATABASE_URL=sqlite:///data/scanner.db
# DATABASE_MIGRATION_URL=

# Tuỳ chỉnh pool Postgres (bỏ trống = mặc định):
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ── Phạm vi dữ liệu store_report ─────────────────────────────────────────
# "shared"   (mặc định): 1 kho chung — mọi chat/nhóm gộp vào 1 DB
# "per_chat": mỗi chat/nhóm là kho riêng (lọc theo group_id)
DATA_SCOPE=shared

# ── Hành vi bot ──────────────────────────────────────────────────────────
# Chế độ quét ảnh:
#   "mention" ★ (production): chỉ quét khi @bot hoặc có caption/command
#   "auto"    (dev/test):     quét mọi ảnh trong nhóm
SCAN_MODE=mention

# Ngưỡng confidence: dưới mức này bot cảnh báo "độ tin cậy thấp" nhưng vẫn lưu
CONFIRM_THRESHOLD=0.6

# Giới hạn số ảnh 1 người gửi/phút (chống spam):
SCAN_RATE_PER_MIN=20

# Gộp nhiều ảnh cùng 1 lượt gửi thành 1 báo cáo cửa hàng (giây).
# Báo cáo hay bị chụp tách nhiều ảnh (doanh thu / số lượng / tồn kho): các ảnh
# gửi liên tiếp bởi CÙNG người trong khoảng này sẽ ghép chung, lấy ngày+cơ sở
# từ ảnh doanh thu. 0 = tắt (mỗi ảnh 1 báo cáo).
REPORT_MERGE_WINDOW_SEC=180

# SSRF: domain CDN ảnh Zalo được phép tải (phẩy ngăn cách).
# Bỏ trống = cho phép mọi host ở dev (IP nội bộ loopback/RFC-1918 vẫn luôn bị chặn).
ZALO_IMAGE_HOST_ALLOWLIST=zadn.vn,zaloapp.com,zalo.me,zdn.vn
